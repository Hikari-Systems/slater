/target
**/*.rs.bk
Cargo.lock.orig

# Local build artefacts / generated graph data are never committed.
/data
/testdata/generated
*.profraw

# Large local input dumps used for import testing (root-level only) — never
# committed. In-tree test fixtures embed their dumps as string constants.
/*.cypher
/*.import
/*.dump

# Local, uncommitted helper scripts.
/scripts/stargazers.sh

# Python bytecode from the perf harnesses.
__pycache__/
*.pyc

# Local, uncommitted notes: client-compatibility / Cypher-gap findings produced
# while integrating downstream services. Kept out of git (and survives `git clean`
# being avoided here) so they aren't wiped on rebuilds.
/client-gaps/

# perf/datasets holds ~10 GB of generated corpora (wikidata_csr.duckdb, the
# derived .cypher dumps, data/). Ignore the payload but TRACK the generators —
# they are small, they are the only reproducible record of how each fixture was
# derived, and a fixture nobody can rebuild is a fixture nobody can trust.
perf/datasets/*
!perf/datasets/*.sql
!perf/datasets/*.sh
!perf/datasets/README.md

# Out-of-tree build dirs used to work around a stale root-owned lock in /target.
/target-dc
/target-merge
target-merge

# Saved browser pages (Claude conversation exports) — never part of the tree
*.html:Zone.Identifier
/*- Claude.html
/*- Claude_files/
